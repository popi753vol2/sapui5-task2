<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Table
        id="booksTable"
        mode="MultiSelect"
        items="{/books}"
        selectionChange=".onSelectionChange"
        noDataText="{i18n>booksNoData}">
        <headerToolbar>
            <Toolbar id="_IDGenToolbar">
                <Title id="_IDGenTitle" text="{i18n>booksTableTitle}" />
                <Input
                    id="bookTitleFilter"
                    value="{ui>/filters/title}"
                    width="12rem"
                    placeholder="{i18n>filterTitlePlaceholder}" />
                <Select
                    id="bookGenreFilter"
                    selectedKey="{ui>/filters/genre}"
                    width="12rem"
                    items="{/genres}">
                    <core:Item id="_IDGenItem" key="{key}" text="{text}" />
                </Select>
                <Button
                    id="filterBooksButton"
                    text="{i18n>filterButton}"
                    icon="sap-icon://filter"
                    press=".onFilterBooks" />
                <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                <Button id="addRecordButton"
                    text="{i18n>addRecord}"
                    icon="sap-icon://add"
                    press=".onAddRecord" />
                <Button id="deleteRecordButton"
                    text="{i18n>deleteRecord}"
                    icon="sap-icon://delete"
                    type="Reject"
                    enabled="{ui>/hasSelection}"
                    press=".onConfirmDelete" />
            </Toolbar>
        </headerToolbar>
        <columns>
            <Column id="_IDGenColumn1">
                <Text id="_IDGenText" text="{i18n>id}" />
            </Column>
            <Column id="_IDGenColumn2"
                minScreenWidth="Tablet"
                demandPopin="true">
                <Text id="_IDGenText1" text="{i18n>name}" />
            </Column>
            <Column id="_IDGenColumn3"
                minScreenWidth="Tablet"
                demandPopin="true">
                <Text id="_IDGenText2" text="{i18n>author}" />
            </Column>
            <Column id="_IDGenColumn4"
                minScreenWidth="Desktop"
                demandPopin="true">
                <Text id="_IDGenText3" text="{i18n>genre}" />
            </Column>
            <Column id="_IDGenColumn5"
                minScreenWidth="Desktop"
                demandPopin="true">
                <Text id="_IDGenText4" text="{i18n>releaseDate}" />
            </Column>
            <Column id="_IDGenColumn6"
                minScreenWidth="Tablet"
                demandPopin="true"
                hAlign="End">
                <Text id="_IDGenText5" text="{i18n>availableQuantity}" />
            </Column>
            <Column id="_IDGenColumn7">
                <Text id="_IDGenText12" text="{i18n>actions}" />
            </Column>
        </columns>
        <items>
            <ColumnListItem id="_IDGenColumnListItem">
                <cells>
                    <Text id="_IDGenText6" text="{ID}" />
                    <VBox id="_IDGenVBox">
                        <Text id="_IDGenText7" text="{Name}" visible="{= !${editMode} }" />
                        <Input id="_IDGenInput" value="{editName}" visible="{editMode}" />
                    </VBox>
                    <Text id="_IDGenText8" text="{Author}" />
                    <Text id="_IDGenText9" text="{Genre}" />
                    <Text id="_IDGenText10" text="{path: 'ReleaseDate', formatter: '.formatter.formatPublishedYear'}" />
                    <ObjectNumber id="_IDGenObjectNumber" number="{AvailableQuantity}" />
                    <VBox id="_IDGenVbox1" renderType="Bare">
                        <Button id="_IDGenButton" text="{i18n>editTitle}" visible="{= !${editMode} }" press=".onHandleAction($event, true)"/>
                        <Button id="_IDGenSaveButton" text="{i18n>saveTitle}" visible="{editMode}" press=".onHandleAction($event, false)" type="Accept"/>
                    </VBox>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>
