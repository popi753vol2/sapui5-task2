<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        id="addBookDialog"
        title="{i18n>addBookDialogTitle}"
        contentWidth="30rem">
        <content>
            <VBox id="_IDGenVBox2" class="sapUiSmallMargin">
                <Label id="_IDGenLabel1" text="{i18n>bookName}" labelFor="bookNameInput" required="true" />
                <Input
                    id="bookNameInput"
                    value="{newBook>/Name}"
                    required="true" />
                <Label id="_IDGenLabel2" text="{i18n>bookAuthor}" labelFor="bookAuthorInput" required="true" />
                <Input
                    id="bookAuthorInput"
                    value="{newBook>/Author}"
                    required="true" />
                <Label id="_IDGenLabel3" text="{i18n>bookGenre}" labelFor="bookGenreInput" required="true" />
                <Input
                    id="bookGenreInput"
                    value="{newBook>/Genre}"
                    required="true" />
                <Label id="_IDGenLabel4" text="{i18n>bookReleaseDate}" labelFor="bookReleaseDateInput" required="true" />
                <DatePicker
                    id="bookReleaseDateInput"
                    value="{newBook>/ReleaseDate}"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="yyyy-MM-dd"
                    required="true" />
                <Label id="_IDGenLabel5" text="{i18n>bookAvailableQuantity}" labelFor="bookQuantityInput" required="true" />
                <Input
                    id="bookQuantityInput"
                    value="{newBook>/AvailableQuantity}"
                    type="Number"
                    required="true" />
            </VBox>
        </content>
        <beginButton>
            <Button id="_IDGenButton1"
                text="{i18n>addBookButton}"
                type="Emphasized"
                press=".onSaveNewBook" />
        </beginButton>
        <endButton>
            <Button id="_IDGenButton2"
                text="{i18n>cancelButton}"
                press=".onCancelAddBook" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
