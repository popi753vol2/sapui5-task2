<mvc:View controllerName="project.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <IconTabBar id="mainTabBar" class="sapUiResponsivePadding--header">
                <items>
                    <IconTabFilter id="jsonModelTab" text="JSON Model" key="jsonModel">
                        <core:Fragment fragmentName="project.view.fragments.JsonModelTab" type="XML"/>
                    </IconTabFilter>

                    <IconTabFilter id="odataV2Tab" text="oData v2 Model" key="odataV2Model">
                        <mvc:XMLView id="odataV2View" viewName="project.view.ODataV2" />
                    </IconTabFilter>

                    <IconTabFilter id="odataV4Tab" text="oData v4 Model" key="odataV4Model">
                        <core:Fragment fragmentName="project.view.fragments.ODataV4Tab" type="XML"/>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>