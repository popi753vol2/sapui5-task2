<mvc:View controllerName="project.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <Table
                id="booksTable"
                mode="MultiSelect"
                items="{/books}"
                selectionChange=".onSelectionChange"
                noDataText="{i18n>booksNoData}">
                <headerToolbar>
                    <Toolbar id="_IDGenToolbar">
                        <Title id="_IDGenTitle" text="{i18n>booksTableTitle}" />
                        <Input
                            id="bookTitleFilter"
                            value="{ui>/filters/title}"
                            width="12rem"
                            placeholder="{i18n>filterTitlePlaceholder}" />
                        <Select
                            id="bookGenreFilter"
                            selectedKey="{ui>/filters/genre}"
                            width="12rem"
                            items="{/genres}">
                            
                            <core:Item id="_IDGenItem" key="{key}" text="{text}" />
                        </Select>
                        <Button
                            id="filterBooksButton"
                            text="{i18n>filterButton}"
                            icon="sap-icon://filter"
                            press=".onFilterBooks" />
                        <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                        <Button id="addRecordButton"
                            text="{i18n>addRecord}"
                            icon="sap-icon://add"
                            press=".onAddRecord" />
                        <Button id="deleteRecordButton"
                            text="{i18n>deleteRecord}"
                            icon="sap-icon://delete"
                            type="Reject"
                            enabled="{ui>/hasSelection}"
                            press=".onDeleteRecord" />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column id="_IDGenColumn1">
                        <Text id="_IDGenText" text="{i18n>bookId}" />
                    </Column>
                    <Column id="_IDGenColumn2"
                        minScreenWidth="Tablet"
                        demandPopin="true">
                        <Text id="_IDGenText1" text="{i18n>bookName}" />
                    </Column>
                    <Column id="_IDGenColumn3"
                        minScreenWidth="Tablet"
                        demandPopin="true">
                        <Text id="_IDGenText2" text="{i18n>bookAuthor}" />
                    </Column>
                    <Column id="_IDGenColumn4"
                        minScreenWidth="Desktop"
                        demandPopin="true">
                        <Text id="_IDGenText3" text="{i18n>bookGenre}" />
                    </Column>
                    <Column id="_IDGenColumn5"
                        minScreenWidth="Desktop"
                        demandPopin="true">
                        <Text id="_IDGenText4" text="{i18n>bookReleaseDate}" />
                    </Column>
                    <Column id="_IDGenColumn6"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        hAlign="End">
                        <Text id="_IDGenText5" text="{i18n>bookAvailableQuantity}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem">
                        <cells>
                            <Text id="_IDGenText6" text="{ID}" />
                            <Text id="_IDGenText7" text="{Name}" />
                            <Text id="_IDGenText8" text="{Author}" />
                            <Text id="_IDGenText9" text="{Genre}" />
                            <Text id="_IDGenText10" text="{path: 'ReleaseDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'yyyy-MM-dd' }}" />
                            <ObjectNumber id="_IDGenObjectNumber" number="{AvailableQuantity}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>